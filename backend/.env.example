MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=POC
MONGO_TIMEOUT_MS=8000

# Módulo Geo — database próprio, populado por scripts/seed_geo.py.
# Sem o search index, o painel de busca (fora do fluxo visível hoje, ver README)
# renderiza "não configurado"; os outros painéis continuam.
GEO_DB=geo
GEO_SEARCH_INDEX=idx_geo_estabelecimento

# Segurança e operação da PoV
# Sem token, mutações só são aceitas de localhost e das origens abaixo.
DEMO_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5184,http://127.0.0.1:5184
MAX_REQUEST_BYTES=1048576
